{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@rnby/racp-codec": ["packages/codec/src/index.ts"],
      "@rnby/racp-client": ["packages/client/src/index.ts"],
      "@rnby/racp-agent": ["packages/agent/src/index.ts"],
      "@rnby/racp-bridge": ["packages/bridge/src/index.ts"]
    }
  }
}
