{
  "name": "@rnby/racp-codec",
  "version": "0.1.0",
  "description": "Language-neutral RACP v1 binary envelope codec.",
  "license": "MIT",
  "author": "RnBy",
  "keywords": ["agent", "binary", "codec", "protocol", "racp", "sha256"],
  "homepage": "https://github.com/rnby-ai/racp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rnby-ai/racp.git",
    "directory": "packages/codec"
  },
  "bugs": {
    "url": "https://github.com/rnby-ai/racp/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "prepack": "npm run build",
    "test": "node --test ../../tests/codec.test.mjs",
    "pack:check": "npm pack --dry-run"
  }
}
