{
  "name": "@rnby/racp-bridge",
  "version": "0.1.0",
  "description": "Typed daemon boundary and intentionally unconfigured bridge stub for RACP adapters.",
  "license": "MIT",
  "author": "RnBy",
  "keywords": ["agent", "bridge", "daemon", "mcp", "racp"],
  "homepage": "https://github.com/rnby-ai/racp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rnby-ai/racp.git",
    "directory": "packages/bridge"
  },
  "bugs": {
    "url": "https://github.com/rnby-ai/racp/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "!dist/.tsbuildinfo", "README.md", "LICENSE"],
  "engines": { "node": ">=22.0.0" },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@rnby/racp-client": "0.1.0"
  },
  "scripts": {
    "build": "tsc -b ../codec/tsconfig.json ../client/tsconfig.json tsconfig.json",
    "prepack": "npm run build",
    "test": "node --test ../../tests/bridge.test.mjs",
    "pack:check": "npm pack --dry-run"
  }
}
